p-3 p-3 rounded-[3px] border bg-[#171f1e] border-[#2a3832] text-[#d5f35b]"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check shrink-0 mt-0.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><div class="flex-1"><p class="text-[10px] font-semibold uppercase tracking-wider mb-0.5 opacity-80">Próximo passo</p><p class="text-[12px] font-medium leading-snug">Leitura inicial: Sistema Financeiro</p></div><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right self-center opacity-60" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></div></div></a></div></main></div>"`;

exports[`telas do Kalibra > renderiza /portal/novo-workspace de forma estável 1`] = `"<div class="k-page-enter min-h-[100dvh] flex flex-col font-sans transition-colors bg-[#10131a] text-[#f0f0e8] selection:bg-[#283322]"><header class="flex h-[68px] items-center justify-between px-5 md:px-9 border-b border-[#242a34]"><a href="/portal" class="flex items-center gap-3"><span class="flex h-7 w-7 items-center justify-center rounded-sm bg-[#d5f35b] text-[#10131a]"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity" aria-hidden="true"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg></span><span class="text-[15px] font-bold tracking-[-0.04em]">kalibra<span class="text-[#d5f35b]">.</span></span></a><div class="flex items-center gap-4"><button class="k-button k-button-quiet text-[12px]">Tema Claro</button></div></header><main class="flex-1 w-full max-w-[700px] mx-auto p-5 md:p-9 mt-4 pb-20"><a href="/portal" class="k-button k-button-quiet mb-8 !px-0 -ml-2 text-[12px]"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg> Voltar ao portal</a><header class="mb-10"><p class="k-eyebrow mb-2">novo workspace</p><h1 class="text-[28px] md:text-[34px] font-semibold tracking-[-0.04em] mb-2">Configure seu programa</h1><p class="text-[13px] text-[#8e98a8]">Forneça os detalhes da prova e o edital. A inteligência do Kalibra fará a extração dos tópicos (integração futura).</p></header><form novalidate="" class="space-y-8"><section class="p-6 md:p-8 rounded-[4px] border bg-[#131821] border-[#29313d]"><h2 class="text-[15px] font-semibold mb-6 flex items-center gap-2"><span class="flex h-5 w-5 items-center justify-center rounded-full bg-[#e5eed5] dark:bg-[#202b20] text-[#5f7900] dark:text-[#d5f35b] text-[10px] font-bold">1</span>Informações Gerais</h2><div class="grid gap-5 sm:grid-cols-2"><div class="space-y-2"><label class="text-[11px] font-medium uppercase tracking-wider text-[#6f7b85] dark:text-[#8e98a8]">Título do Programa</label><input class="k-input" placeholder="Ex: Auditor Fiscal" type="text" value=""></div><div class="space-y-2"><label class="text-[11px] font-medium uppercase tracking-wider text-[#6f7b85] dark:text-[#8e98a8]">Instituição / Banca</label><input class="k-input" placeholder="Ex: FGV" type="text" value=""></div><div class="space-y-2"><label class="text-[11px] font-medium uppercase tracking-wider text-[#6f7b85] dark:text-[#8e98a8]">Data da Prova</label><input class="k-input" type="date" value=""></div><div class="space-y-2"><label class="text-[11px] font-medium uppercase tracking-wider text-[#6f7b85] dark:text-[#8e98a8]">Tipo</label><select class="k-input"><option value="Concurso Público">Concurso Público</option><option value="Vestibular">Vestibular</option><option value="Exame de Ordem (OAB)">Exame de Ordem (OAB)</option><option value="Certificação">Certificação</option></select></div></div><div class="mt-5 space-y-2"><label class="text-[11px] font-medium uppercase tracking-wider text-[#6f7b85] dark:text-[#8e98a8]">Cargos</label><div class="space-y-2" data-testid="fields-cargos"><div class="k-option grid gap-2 p-3 sm:grid-cols-[minmax(0,1fr)_130px_90px_auto]"><input class="k-input" placeholder="Nome do cargo" data-testid="input-cargo-nome-0" value=""><input class="k-input" data-testid="input-cargo-data-0" type="date" value=""><input class="k-input" placeholder="Período" data-testid="input-cargo-periodo-0" value=""><button type="button" class="k-button k-button-quiet k-icon-button k-coral" disabled="" aria-label="Remover cargo 1" data-testid="button-remover-cargo-0"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><button type="button" class="k-button k-button-quiet text-[11px]" data-testid="button-adicionar-cargo"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> Adicionar cargo</button></div></div></section><section class="p-6 md:p-8 rounded-[4px] border bg-[#131821] border-[#29313d]"><h2 class="text-[15px] font-semibold mb-6 flex items-center gap-2"><span class="flex h-5 w-5 items-center justify-center rounded-full bg-[#e5eed5] dark:bg-[#202b20] text-[#5f7900] dark:text-[#d5f35b] text-[10px] font-bold">2</span>Conteúdo do Edital</h2><div class="mb-6 flex gap-1 p-1 rounded-[4px] bg-[#f1f4f2] dark:bg-[#0b0e13] border border-[#dfe6e4] dark:border-[#242a34]"><button type="button" class="flex-1 flex justify-center py-2 text-[12px] font-medium rounded-[3px] transition-colors bg-white dark:bg-[#202b20] text-[#16232b] dark:text-[#d5f35b] shadow-sm border border-[#d5dede] dark:border-[#35404e]">Anexar Arquivo</button><button type="button" class="flex-1 flex justify-center py-2 text-[12px] font-medium rounded-[3px] transition-colors text-[#6f7b85] dark:text-[#8e98a8] hover:text-[#16232b] dark:hover:text-[#f0f0e8]">Colar Texto</button><button type="button" class="flex-1 flex justify-center py-2 text-[12px] font-medium rounded-[3px] transition-colors text-[#6f7b85] dark:text-[#8e98a8] hover:text-[#16232b] dark:hover:text-[#f0f0e8]">Ainda não tenho</button></div><div class="relative"><input id="edital-file" accept=".pdf,.docx,.txt" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" type="file"><div class="flex flex-col items-center justify-center py-10 px-4 rounded-[4px] border-2 border-dashed text-center transition-colors pointer-events-none border-[#d5dede] dark:border-[#35404e] bg-[#f6f8f7] dark:bg-[#10131a]"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cloud-upload text-[#8e98a8] mb-3" aria-hidden="true"><path d="M12 13v8"></path><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path><path d="m8 17 4-4 4 4"></path></svg><p class="text-[14px] font-medium mb-1">Selecione ou arraste o arquivo do edital</p><p class="text-[11px] text-[#6f7b85] dark:text-[#8e98a8]">Aceita PDF, DOCX ou TXT (Max 20MB)</p></div></div></section><section class="p-6 md:p-8 rounded-[4px] border bg-[#131821] border-[#29313d]"><h2 class="text-[15px] font-semibold mb-6 flex items-center gap-2"><span class="flex h-5 w-5 items-center justify-center rounded-full bg-[#e5eed5] dark:bg-[#202b20] text-[#5f7900] dark:text-[#d5f35b] text-[10px] font-bold">3</span>Disponibilidade semanal</h2><div class="space-y-3" data-testid="fields-disponibilidade"><div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4"><div class="k-option p-3"><p class="k-eyebrow mb-2">segunda-feira</p><div class="flex items-center gap-2"><input min="0" step="50" class="k-input" data-testid="input-disponibilidade-1" type="number" value="0"><span class="k-mono text-[10px] k-muted">min</span></div></div><div class="k-option p-3"><p class="k-eyebrow mb-2">terça-feira</p><div class="flex items-center gap-2"><input min="0" step="50" class="k-input" data-testid="input-disponibilidade-2" type="number" value="0"><span class="k-mono text-[10px] k-muted">min</span></div></div><div class="k-option p-3"><p class="k-eyebrow mb-2">quarta-feira</p><div class="flex items-center gap-2"><input min="0" step="50" class="k-input" data-testid="input-disponibilidade-3" type="number" value="0"><span class="k-mono text-[10px] k-muted">min</span></div></div><div class="k-option p-3"><p class="k-eyebrow mb-2">quinta-feira</p><div class="flex items-center gap-2"><input min="0" step="50" class="k-input" data-testid="input-disponibilidade-4" type="number" value="0"><span class="k-mono text-[10px] k-muted">min</span></div></div><div class="k-option p-3"><p class="k-eyebrow mb-2">sexta-feira</p><div class="flex items-center gap-2"><input min="0" step="50" class="k-input" data-testid="input-disponibilidade-5" type="number" value="0"><span class="k-mono text-[10px] k-muted">min</span></div></div><div class="k-option p-3"><p class="k-eyebrow mb-2">sábado</p><div class="flex items-center gap-2"><input min="0" step="50" class="k-input" data-testid="input-disponibilidade-6" type="number" value="0"><span class="k-mono text-[10px] k-muted">min</span></div></div><div class="k-option p-3"><p class="k-eyebrow mb-2">domingo</p><div class="flex items-center gap-2"><input min="0" step="50" class="k-input" data-testid="input-disponibilidade-0" type="number" value="0"><span class="k-mono text-[10px] k-muted">min</span></div></div></div><div class="flex flex-col gap-3 border-t border-[#d5dede] pt-3 dark:border-[#242a34] sm:flex-row sm:items-center sm:justify-between"><label class="flex items-center gap-2 text-[11px] k-muted">Sessão máxima<input min="5" step="5" class="k-input w-[90px]" data-testid="input-sessao-maxima" type="number" value="50"><span class="k-mono text-[10px]">min</span></label><span class="k-mono text-[11px] k-muted">total semanal <span class="k-focus">0h 00</span></span></div></div></section><div class="flex justify-end gap-3 pt-4 border-t border-[#d5dede] dark:border-[#242a34]"><a href="/portal" class="k-button k-button-quiet">Cancelar</a><button type="submit" class="k-button k-button-primary px-8">Criar Workspace</button></div></form></main></div>"`;

exports[`telas do Kalibra > renderiza /rota-inexistente de forma estável 1`] = `"<div class="flex min-h-[70vh] flex-col items-center justify-center text-center"><span class="k-mono text-[52px] text-[#d5f35b]">404</span><h2 class="mt-4 text-xl font-semibold">Página fora do ciclo</h2><p class="mt-2 text-[12px] text-[#8e98a8]">Este caminho não existe no workspace atual.</p><a data-testid="link-back-dashboard" href="/" class="k-button k-button-primary mt-6">Voltar à visão geral</a></div>"`;

