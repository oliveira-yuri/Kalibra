# Segredos e configuração — nunca versionar valores reais, só nomes.
# Ver docs/superpowers/specs/2026-09-12-kalibra-design.md §3.5.

# Postgres do api-server (lib/db). Ex.: postgres://user:senha@host:5432/kalibra
DATABASE_URL=

# Claude API — usada só pelo api-server/worker, nunca pelo frontend.
ANTHROPIC_API_KEY=

# Clerk — par de chaves do lado do servidor (api-server).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Clerk — par de chaves expostas ao frontend (artifacts/kalibra, via Vite).
VITE_CLERK_PUBLISHABLE_KEY=
# Preservado do setup Replit; URL do proxy do Frontend API do Clerk.
VITE_CLERK_PROXY_URL=

# Storage compatível com S3 para anexos/uploads.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Bot do Telegram usado pelas integrações do Kalibra.
TELEGRAM_BOT_TOKEN=

# Token que autentica callbacks recebidos do Hermes.
HERMES_INBOUND_TOKEN=
